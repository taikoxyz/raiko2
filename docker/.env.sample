# Copy to docker/.env and fill the RPC endpoints before starting compose.

COMPOSE_PROJECT_NAME=raiko2
RAIKO2_IMAGE=raiko2:local
# Default builds include RISC Zero local/network and SP1. Use this for extra features such as
# `--features redis-queue`.
BIN_FEATURES=
RUST_LOG=info

# Publish container port 8080 on the host.
RAIKO2_PUBLIC_PORT=8080

# Atomic prover enablement override. Entries omitted here are disabled; selected runners replace
# the matching execution selectors in config.compose.toml.
# Keep risc0/local for this one-container quickstart. Combined production routes require a config
# based on config.example.toml with matching backend settings and real credentials.
# Supported pairs: risc0 local/network; sp1 local/network; native local; sgx remote; sgxgeth remote.
RAIKO2_PROVER_ROUTES=risc0/local

# RPC endpoints. host.docker.internal works when your nodes run on the host machine.
RAIKO2_L1_RPC=http://host.docker.internal:8545
RAIKO2_L2_RPC=http://host.docker.internal:9545
RAIKO2_L1_CHAIN_ID=1
RAIKO2_L2_CHAIN_ID=167000

# Queue settings. The default Docker path uses the in-process memory queue.
RAIKO2_QUEUE_BACKEND=memory
RAIKO2_QUEUE_NAMESPACE=raiko2:docker
RAIKO2_QUEUE_WORKERS=1
RAIKO2_QUEUE_MAINTENANCE_INTERVAL_MS=200
