# Gramine manifest for the dedicated raiko2 SGX proving runtime.

libos.entrypoint = "/raiko2-sgx-prover"
loader.entrypoint = "file:{{ gramine.libos }}"
loader.env.HOME = "/root"
loader.env.LD_LIBRARY_PATH = "/lib:{{ arch_libdir }}"
loader.env.RUST_LOG = "info"
loader.insecure__use_cmdline_argv = true
loader.log_level = "{{ log_level }}"

fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/raiko2-sgx-prover", uri = "file:raiko2-sgx-prover" },
  { path = "{{ arch_libdir }}", uri = "file:{{ arch_libdir }}" },
  { path = "/usr/lib/ssl/certs/", uri = "file:/usr/lib/ssl/certs/" },
  { path = "/etc/ssl/certs/", uri = "file:/etc/ssl/certs/" },
  { path = "/var/lib/raiko2/sgx/config", uri = "file:/var/lib/raiko2/sgx/config" },
  { path = "/var/lib/raiko2/sgx/secrets", uri = "file:/var/lib/raiko2/sgx/secrets", type = "encrypted", key_name = "_sgx_mrenclave" },
  { path = "/proc/self/mountinfo", uri = "file:/proc/self/mountinfo" },
  { path = "/proc/self/cgroup", uri = "file:/proc/self/cgroup" },
  { path = "/sys/fs/cgroup/", uri = "file:/sys/fs/cgroup/" },
]

sgx.allowed_files = [
  "file:/var/lib/raiko2/sgx/config",
  "file:/proc/self/mountinfo",
  "file:/proc/self/cgroup",
  "file:/sys/fs/cgroup/",
]

sgx.debug = false
sgx.edmm_enable = {{ edmm_enable }}
sgx.trusted_files = [
  "file:{{ gramine.libos }}",
  "file:{{ gramine.runtimedir() }}/",
  "file:{{ arch_libdir }}/",
  "file:/usr/lib/ssl/certs/",
  "file:/etc/ssl/certs/",
  "file:raiko2-sgx-prover",
]
sgx.max_threads = 256
sgx.remote_attestation = "dcap"

sys.enable_extra_runtime_domain_names_conf = true
sys.insecure__allow_eventfd = true
sys.stack.size = "8M"
sgx.enclave_size = "4G"
