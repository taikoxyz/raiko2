# Copy to docker/.env.sgx.regression before starting the SGX regression stack.

COMPOSE_PROJECT_NAME=raiko2-sgx-regression
RUST_LOG=info

# Images
RAIKO2_IMAGE=raiko2:local
RAIKO2_SGX_IMAGE=raiko2-sgx:local
# Build or pull this image from the gaiko2 repository separately.
GAIKO2_SGXGETH_IMAGE=gaiko2-tee:latest

# Shared PCCS endpoint reachable from containers.
PCCS_HOST=host.docker.internal:8081

# Optional full-docker raiko2 service
RAIKO2_PUBLIC_PORT=8080
RAIKO2_L1_RPC=http://host.docker.internal:8545
RAIKO2_L2_RPC=http://host.docker.internal:9545
RAIKO2_L1_CHAIN_ID=1
RAIKO2_L2_CHAIN_ID=167000
# Full route-table replacement; enables both remote SGX lanes from config.compose.toml.
RAIKO2_PROVER_ROUTES=sgx/remote,sgxgeth/remote
RAIKO2_QUEUE_BACKEND=memory
RAIKO2_QUEUE_NAMESPACE=raiko2:docker
RAIKO2_QUEUE_WORKERS=1
RAIKO2_QUEUE_MAINTENANCE_INTERVAL_MS=200

# Dockerized raiko2 uses `proof_type` to pick the remote SGX lane:
# - `sgx`     -> RAIKO2_REMOTE_SGX_BASE_URL
# - `sgxgeth` -> RAIKO2_REMOTE_SGX_SGXGETH_BASE_URL
RAIKO2_REMOTE_SGX_BASE_URL=http://raiko2-sgx:8080
RAIKO2_REMOTE_SGX_SGXGETH_BASE_URL=http://gaiko2-sgxgeth:8080
RAIKO2_REMOTE_SGX_TIMEOUT_MS=300000

# Host ports for the two remote SGX services. These are the URLs to use from a local raiko2 CLI:
# - sgx     -> http://127.0.0.1:${RAIKO2_SGX_PUBLIC_PORT}
# - sgxgeth -> http://127.0.0.1:${GAIKO2_SGXGETH_PUBLIC_PORT}
RAIKO2_SGX_PUBLIC_PORT=9090
GAIKO2_SGXGETH_PUBLIC_PORT=8090

# raiko2-sgx-prover tee lifecycle
RAIKO2_SGX_MODE=tee
RAIKO2_SGX_FORK=shasta
# Regression default so `raiko2-sgx` can serve without an onchain registration step.
# Replace this with the registered instance id (or mount `registered.json`) for chain-verifying deployments.
RAIKO2_SGX_INSTANCE_ID=3131899904
RAIKO2_SGX_CONFIG_DIR_HOST=./var/raiko2-sgx/config
RAIKO2_SGX_SECRET_DIR_HOST=./var/raiko2-sgx/secrets
RAIKO2_SGX_ENCLAVE_KEY_HOST=${HOME}/.config/gramine/enclave-key.pem
GRAMINE_LOG_LEVEL=error
SGX_EDMM_ENABLE=false

# gaiko2 sgxgeth lifecycle
GAIKO2_TEE_TYPE=ego
GAIKO2_FORK=shasta
# Regression default so `gaiko2-sgxgeth` can produce tee proofs without a registration step.
# Replace this with the registered instance id for chain-verifying deployments.
GAIKO2_INSTANCE_ID=3131899905
GAIKO2_CONFIG_DIR_HOST=./var/gaiko2-sgxgeth/config
GAIKO2_SECRET_DIR_HOST=./var/gaiko2-sgxgeth/secrets
