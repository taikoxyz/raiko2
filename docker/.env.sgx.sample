# Copy to docker/.env.sgx before starting the SGX compose stack.

COMPOSE_PROJECT_NAME=raiko2-sgx
RAIKO2_SGX_IMAGE=raiko2-sgx:local
RUST_LOG=info
GRAMINE_LOG_LEVEL=error

# Publish the SGX sign server on the host.
RAIKO2_SGX_PUBLIC_PORT=8090

# SGX runtime directories on the host.
RAIKO2_SGX_CONFIG_DIR_HOST=./var/sgx/config
RAIKO2_SGX_SECRET_DIR_HOST=./var/sgx/secrets
RAIKO2_SGX_GRAMINE_DIR_HOST=${HOME}/.config/gramine

# Service identity selection.
# Set RAIKO2_SGX_INSTANCE_ID directly or leave it empty and provide a registered.json mapping
# that contains the selected fork.
RAIKO2_SGX_MODE=tee
RAIKO2_SGX_FORK=shasta
RAIKO2_SGX_INSTANCE_ID=

# Set `RAIKO2_SGX_MODE=native` for operator/link testing. Native mode reuses the fixed
# `native/local` signer identity, skips quote generation, and treats `bootstrap` as a no-op.
# The compose file still mounts SGX devices by default; remove those mounts locally if you need
# native mode on a host without SGX hardware.

# PCCS host reachable from inside the container.
PCCS_HOST=host.docker.internal:8081
